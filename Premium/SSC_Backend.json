{
    "product_name": "SSC Mission Mode",
    "version": "1.0.0",
    "objective": "Provide the backend systems, data model, business rules, APIs, jobs, and premium enforcement required to power an adaptive SSC study execution engine.",
    "system_goals": [
        "Generate personalized study plans from user inputs.",
        "Continuously adapt future tasks based on performance and missed days.",
        "Maintain a revision engine with spaced review behavior.",
        "Convert mock data into recovery plans and weak-area tasks.",
        "Track readiness using interpretable signals.",
        "Enforce premium gating at the domain and API level."
    ],
    "non_goals": [
        "hosting large video-course infrastructure",
        "full mock delivery engine",
        "mass content library management",
        "real-time competitive rank prediction",
        "open-ended AI tutoring in MVP"
    ],
    "architecture": {
        "style": "modular monolith",
        "modules": [
            "auth",
            "premium_access",
            "mission_profile",
            "mission_plan",
            "mission_tasks",
            "focus_sessions",
            "revision_engine",
            "mock_analysis",
            "recovery_engine",
            "backlog_rescue",
            "readiness_engine",
            "notifications",
            "analytics_events",
            "admin"
        ],
        "api_style": "REST",
        "background_processing": "job queue with scheduled workers",
        "storage": {
            "primary_db": "MongoDB or PostgreSQL compatible design",
            "cache": "Redis",
            "jobs": "Redis-backed queue or equivalent"
        }
    },
    "premium_enforcement": {
        "principle": "All adaptive intelligence routes must require active premium entitlement.",
        "gated_capabilities": [
            "mission plan generation",
            "adaptive rescheduling",
            "revision queue generation",
            "mock recovery analysis",
            "backlog rescue",
            "readiness calculations beyond basic summary"
        ],
        "free_capabilities": [
            "manual study logging",
            "basic timer logging",
            "basic task history"
        ],
        "checks": [
            "middleware entitlement check",
            "server-side feature flag verification",
            "client-safe capability response"
        ]
    },
    "domain_entities": [
        {
            "name": "UserMissionProfile",
            "description": "Persistent planning profile for a user.",
            "fields": {
                "id": "string",
                "user_id": "string",
                "exam_type": "enum",
                "target_exam_date": "date",
                "daily_hours_weekday": "number",
                "daily_hours_weekend": "number",
                "preferred_study_slots": "array<string>",
                "off_days": "array<string>",
                "language_preference": "enum",
                "current_stage": "enum",
                "subject_confidence": "object",
                "uses_external_mocks": "boolean",
                "is_active": "boolean",
                "created_at": "datetime",
                "updated_at": "datetime"
            }
        },
        {
            "name": "MissionPlan",
            "description": "Top-level active mission plan for a user.",
            "fields": {
                "id": "string",
                "user_id": "string",
                "profile_id": "string",
                "status": "enum",
                "start_date": "date",
                "end_date": "date",
                "target_exam_date": "date",
                "generation_version": "string",
                "last_rebalanced_at": "datetime",
                "last_backlog_rescue_at": "datetime",
                "readiness_snapshot_id": "string|null",
                "created_at": "datetime",
                "updated_at": "datetime"
            }
        },
        {
            "name": "MissionTask",
            "description": "Atomic unit of planned work.",
            "fields": {
                "id": "string",
                "plan_id": "string",
                "user_id": "string",
                "date": "date",
                "subject": "enum",
                "topic_id": "string",
                "topic_name": "string",
                "task_type": "enum",
                "source": "enum",
                "priority": "enum",
                "estimated_minutes": "number",
                "status": "enum",
                "linked_revision_item_id": "string|null",
                "linked_mock_id": "string|null",
                "sequence_index": "number",
                "completion_confidence": "number|null",
                "notes_summary": "string|null",
                "created_at": "datetime",
                "updated_at": "datetime"
            }
        },
        {
            "name": "FocusSession",
            "description": "Actual time spent against a mission task.",
            "fields": {
                "id": "string",
                "user_id": "string",
                "task_id": "string|null",
                "started_at": "datetime",
                "ended_at": "datetime|null",
                "planned_minutes": "number",
                "actual_minutes": "number|null",
                "break_count": "number",
                "end_reason": "enum|null",
                "completion_state": "enum|null",
                "confidence_after_session": "number|null",
                "notes": "string|null",
                "created_at": "datetime",
                "updated_at": "datetime"
            }
        },
        {
            "name": "RevisionItem",
            "description": "Represents a topic that must return for spaced revision.",
            "fields": {
                "id": "string",
                "user_id": "string",
                "plan_id": "string",
                "subject": "enum",
                "topic_id": "string",
                "topic_name": "string",
                "origin_task_id": "string|null",
                "last_completed_at": "datetime|null",
                "next_due_date": "date",
                "interval_stage": "number",
                "risk_level": "enum",
                "status": "enum",
                "due_reason": "enum",
                "snooze_count": "number",
                "created_at": "datetime",
                "updated_at": "datetime"
            }
        },
        {
            "name": "MockResult",
            "description": "User-submitted mock performance input.",
            "fields": {
                "id": "string",
                "user_id": "string",
                "plan_id": "string|null",
                "mock_name": "string",
                "date_taken": "date",
                "overall_score": "number",
                "overall_accuracy": "number|null",
                "section_scores": "json",
                "section_time_spent": "json",
                "topic_accuracy": "json",
                "topic_error_flags": "json",
                "raw_input_version": "string",
                "created_at": "datetime",
                "updated_at": "datetime"
            }
        },
        {
            "name": "MockRecoveryPlan",
            "description": "Action plan generated from a mock result.",
            "fields": {
                "id": "string",
                "user_id": "string",
                "mock_result_id": "string",
                "risk_summary": "json",
                "weak_topics": "json",
                "careless_error_topics": "json",
                "recommended_actions": "json",
                "three_day_plan": "json",
                "accepted_at": "datetime|null",
                "created_at": "datetime"
            }
        },
        {
            "name": "ReadinessSnapshot",
            "description": "Interpretable preparation health calculation.",
            "fields": {
                "id": "string",
                "user_id": "string",
                "plan_id": "string",
                "score": "number",
                "band": "enum",
                "coverage_score": "number",
                "consistency_score": "number",
                "revision_health_score": "number",
                "mock_health_score": "number",
                "backlog_risk_score": "number",
                "top_risks": "json",
                "top_strengths": "json",
                "computed_at": "datetime"
            }
        },
        {
            "name": "BacklogEvent",
            "description": "Detected inactivity or study slippage event.",
            "fields": {
                "id": "string",
                "user_id": "string",
                "plan_id": "string",
                "missed_days_count": "number",
                "overdue_revision_count": "number",
                "open_priority_task_count": "number",
                "detected_at": "datetime",
                "status": "enum",
                "rescue_plan_preview": "json|null",
                "accepted_at": "datetime|null"
            }
        }
    ],
