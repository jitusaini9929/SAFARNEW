        ]
    },
    "planner_engine": {
        "goal": "Generate a realistic study plan based on exam date, available hours, user stage, and subject confidence.",
        "inputs": [
            "target_exam_date",
            "daily_hours_weekday",
            "daily_hours_weekend",
            "off_days",
            "subject_confidence",
            "current_stage",
            "preferred_study_slots"
        ],
        "outputs": [
            "first 7 days of tasks",
            "weekly distribution",
            "subject balance targets",
            "initial revision candidates",
            "first mock schedule"
        ],
        "rules": [
            "Never over-allocate beyond declared available hours.",
            "Weak subjects receive more early volume but not so much that the user avoids the plan.",
            "At least one revision-oriented task should appear after initial learning blocks begin.",
            "Mock tasks should appear only after minimum foundational threshold or explicit user preference.",
            "If exam is close, prioritize high-yield topics and revision over broad coverage."
        ],
        "rebalancing_rules": [
            "When a task is skipped, future dates may be adjusted only within available capacity.",
            "Repeated skipped low-priority tasks may be compressed or dropped during rescue.",
            "High-priority repair and revision tasks must be preserved unless manually deferred."
        ]
    },
    "revision_engine": {
        "goal": "Ensure studied topics return before they decay.",
        "item_creation_triggers": [
            "completed learn task",
            "completed practice task with low confidence",
            "weak topic from mock recovery",
            "manual admin injection"
        ],
        "default_intervals_days": [
            1,
            3,
            7,
            14
        ],
        "adaptive_rules": [
            "If completion confidence is low, shorten next interval.",
            "If topic appears weak in mock, escalate risk and bring due date forward.",
            "If user snoozes repeatedly, cap snooze count and mark as high risk.",
            "If revision completed strongly, promote to next interval stage."
        ],
        "overdue_policy": [
            "carry overdue items forward",
            "limit visible due count to avoid overload",
            "merge low-risk overdue items into next available revision block when needed"
        ]
    },
    "mock_analysis_engine": {
        "goal": "Transform raw mock numbers into interpretable weaknesses and action steps.",
        "required_inputs": [
            "overall score",
            "section scores"
        ],
        "optional_inputs": [
            "section time spent",
            "topic accuracy",
            "careless error flags",
            "notes"
        ],
        "derived_outputs": [
            "weak topics",
            "careless error topics",
            "speed bottlenecks",
            "accuracy bottlenecks",
            "priority repair actions",
            "three_day recovery plan"
        ],
        "heuristics": [
            "If accuracy is low and time spent is high, classify as concept weakness or confusion.",
            "If accuracy is low and time spent is low, classify as careless or rushed behavior.",
            "If section score trend drops across recent mocks, raise repair priority.",
            "Topics repeated as weak across mocks should inject repair tasks directly into plan."
        ]
    },
    "recovery_engine": {
        "goal": "Create short, realistic repair sequences after weak mock results.",
        "output_structure": {
            "summary": "one-line explanation",
            "priority_topics": "array",
            "three_day_plan": "array of day buckets",
            "repair_task_templates": "array",
            "plan_adjustments": "array"
        },
        "rules": [
            "Recovery plan must stay limited and actionable.",
            "Do not flood the user with more than 3 high-priority repair topics at once.",
            "Each repair topic should map to concrete task types such as concept repair, timed drill, formula review, or revision."
        ]
    },
    "backlog_rescue_engine": {
        "goal": "Recover the user after missed days without collapsing the plan.",
        "trigger_conditions": [
            "2 or more missed study days",
            "3 or more overdue revisions",
            "readiness drops due to inactivity",
            "unresolved high-priority tasks exceed threshold"
        ],
        "rescue_actions": [
            "compress future low-priority tasks",
            "reschedule high-priority tasks",
            "merge revision tasks where safe",
            "drop low-value duplicates",
            "rebuild next 3 to 7 days realistically"
        ],
        "constraints": [
            "do not exceed available daily time",
            "preserve at least one revision touchpoint if revision debt exists",
            "protect mock-recovery critical tasks when recent mock weakness exists"
        ]
    },
    "readiness_engine": {
        "goal": "Provide a transparent preparation health score.",
        "score_components": [
            {
                "name": "coverage_score",
                "weight": 0.25
            },
            {
                "name": "consistency_score",
                "weight": 0.25
            },
            {
                "name": "revision_health_score",
                "weight": 0.25
            },
            {
                "name": "mock_health_score",
                "weight": 0.15
            },
            {
                "name": "backlog_risk_score",
                "weight": 0.10
            }
        ],
        "rules": [
            "Readiness must be interpretable, not marketed as guaranteed exam success.",
            "Missing mock data should reduce precision, not break calculation.",
            "Long inactivity should damage consistency and backlog health quickly.",
            "High overdue revisions should damage revision health more than low-risk unrevised topics."
        ],
        "output_contract": {
            "score_range": "0-100",
            "band_mapping": {
                "critical": "0-39",
                "weak": "40-59",
                "stable": "60-79",
                "strong": "80-100"
            },
            "must_include": [
                "top risks",
                "top strengths",
                "delta from prior snapshot if available"
            ]
        }
    },
    "api_spec": {
        "auth_required": true,
        "base_path": "/api/mission",
        "endpoints": [
            {
                "method": "POST",
                "path": "/profile",
                "purpose": "create or update mission profile",
                "premium_required": false,
                "request": {
                    "exam_type": "string",
                    "target_exam_date": "date",
                    "daily_hours_weekday": "number",
                    "daily_hours_weekend": "number",
                    "preferred_study_slots": "array<string>",
                    "off_days": "array<string>",
                    "language_preference": "string",
                    "current_stage": "string",
                    "subject_confidence": "object",
                    "uses_external_mocks": "boolean"
                },
                "response": {
                    "profile_id": "string",
                    "saved": "boolean"
                }
            },
            {
                "method": "POST",
                "path": "/plan/generate",
                "purpose": "generate first active mission plan",
                "premium_required": true,
                "request": {
                    "profile_id": "string"
                },
                "response": {
                    "plan_id": "string",
                    "status": "string",
                    "first_week_tasks": "array",
                    "readiness_preview": "object"
                }
            },
            {
                "method": "GET",
                "path": "/plan/active",
                "purpose": "fetch active mission plan summary",
                "premium_required": true,
                "response": {
                    "plan": "object",
                    "today_summary": "object",
                    "readiness_snapshot": "object"
                }
            },
            {
                "method": "GET",
                "path": "/today",
                "purpose": "fetch today's mission tasks, due revisions, rescue alerts, and active recovery items",
                "premium_required": true,
                "response": {
                    "tasks": "array",
                    "due_revisions": "array",
                    "backlog_alert": "object|null",
                    "active_recovery": "object|null",
                    "readiness_snapshot": "object"
                }
            },
            {
                "method": "GET",
                "path": "/plan/calendar",
                "purpose": "fetch date-bucketed plan tasks",
                "premium_required": true,
                "query": {
                    "from": "date",
                    "to": "date"
                },
                "response": {
                    "days": "array"
                }
            },
            {
                "method": "PATCH",
                "path": "/tasks/:taskId",
                "purpose": "update task status or reschedule task",
                "premium_required": true,
                "request": {
                    "status": "string|null",
                    "date": "date|null",
                    "completion_confidence": "number|null"
                },
                "response": {
                    "task": "object",
                    "side_effects": "object"
                }
            },
            {
                "method": "POST",
                "path": "/sessions",
                "purpose": "start a focus session",
                "premium_required": false,
                "request": {
                    "task_id": "string|null",
                    "planned_minutes": "number"
                },
                "response": {
                    "session_id": "string",
                    "started_at": "datetime"
                }
            },
            {
                "method": "PATCH",
                "path": "/sessions/:sessionId/complete",
                "purpose": "complete or stop a focus session",
                "premium_required": false,
                "request": {
                    "actual_minutes": "number",
                    "break_count": "number",
                    "end_reason": "string",
                    "completion_state": "string",
                    "confidence_after_session": "number|null",
                    "notes": "string|null"
                },
                "response": {
                    "session": "object",
                    "linked_task_update": "object|null",
                    "readiness_delta": "object|null"
                }
            },
            {
                "method": "GET",
                "path": "/revision",
                "purpose": "fetch revision queue",
                "premium_required": true,
                "query": {
                    "bucket": "due|overdue|upcoming|all"
                },
                "response": {
                    "items": "array"
                }
            },
            {
                "method": "PATCH",
                "path": "/revision/:revisionId/complete",
                "purpose": "complete a revision item and schedule next interval",
                "premium_required": true,
                "request": {
                    "confidence": "number"
                },
                "response": {
                    "revision_item": "object",
                    "next_due_date": "date"
                }
            },
            {
                "method": "PATCH",
                "path": "/revision/:revisionId/snooze",
                "purpose": "snooze revision with penalty rules",
                "premium_required": true,
                "request": {
                    "days": "number"
                },
                "response": {
                    "revision_item": "object"
                }
            },
            {
                "method": "POST",
                "path": "/mocks",
                "purpose": "submit mock result",
                "premium_required": true,
                "request": {
                    "mock_name": "string",
                    "date_taken": "date",
                    "overall_score": "number",
                    "overall_accuracy": "number|null",
                    "section_scores": "object",
                    "section_time_spent": "object|null",
                    "topic_accuracy": "object|null",
                    "topic_error_flags": "object|null"
                },
                "response": {
                    "mock_result_id": "string",
                    "analysis_ready": "boolean"
                }
            },
            {
                "method": "GET",
                "path": "/mocks/:mockId/analysis",
                "purpose": "fetch mock analysis and recovery plan",
                "premium_required": true,
                "response": {
                    "analysis": "object",
                    "recovery_plan": "object"
                }
            },
            {
                "method": "POST",
                "path": "/mocks/:mockId/recovery/accept",
                "purpose": "inject recovery tasks into mission plan",
                "premium_required": true,
                "request": {
                    "mode": "add_to_today|spread_across_3_days|merge_with_plan"
                },
                "response": {
                    "accepted": "boolean",
                    "inserted_tasks": "array"
                }
            },
            {
                "method": "GET",
                "path": "/progress/readiness",
                "purpose": "fetch latest readiness snapshot and trends",
                "premium_required": true,
                "response": {
                    "latest": "object",
                    "history": "array"
                }
            },
            {
                "method": "GET",
                "path": "/backlog/status",
                "purpose": "check if backlog rescue is needed",
                "premium_required": true,
                "response": {
                    "has_backlog": "boolean",
                    "event": "object|null"
                }
            },
            {
                "method": "POST",
                "path": "/backlog/preview",
                "purpose": "generate rescue preview",
                "premium_required": true,
                "response": {
                    "event_id": "string",
                    "preview": "object"
                }
            },
            {
                "method": "POST",
                "path": "/backlog/:eventId/accept",
                "purpose": "accept rescue preview and rebuild future plan",
                "premium_required": true,
                "response": {
                    "accepted": "boolean",
                    "updated_plan_window": "array"
                }
            },
            {
                "method": "GET",
                "path": "/weekly-review",
                "purpose": "fetch weekly review summary",
                "premium_required": true,
                "response": {
                    "completion_summary": "object",
                    "revision_summary": "object",
                    "mock_summary": "object",
                    "next_week_focus": "array"
                }
            }
        ]
    },
    "jobs_and_schedulers": {
        "jobs": [
            {
                "name": "compute_daily_revision_queue",
                "frequency": "daily early morning",
                "purpose": "mark due revisions and overdue items"
            },
            {
                "name": "detect_backlog_events",
                "frequency": "daily",
                "purpose": "find users needing rescue"
            },
            {
                "name": "compute_readiness_snapshots",
                "frequency": "daily and after major mutations",
                "purpose": "refresh readiness"
            },
            {
                "name": "analyze_mock_result",
                "frequency": "async on mock submission",
                "purpose": "generate mock analysis and recovery plan"
            },
            {
                "name": "weekly_review_compiler",
                "frequency": "weekly",
                "purpose": "prepare weekly review data"
            },
            {
                "name": "nudge_dispatcher",
                "frequency": "hourly",
                "purpose": "send mission-related notifications"
            }
        ]
    },
    "notification_logic": {
        "events": [
            "today_plan_ready",
            "revision_due_today",
            "backlog_detected",
            "readiness_drop_alert",
            "weekly_review_ready"
        ],
        "rules": [
            "Do not send more than 2 priority notifications per day.",
            "No notification without a linked action target.",
            "Suppress reminders after user completes daily plan."
        ]
    },
    "analytics_and_observability": {
        "event_stream": [
            "mission_profile_saved",
            "mission_plan_generated",
            "task_completed",
            "task_skipped",
            "revision_completed",
            "revision_snoozed",
            "mock_submitted",
            "mock_analysis_generated",
            "mock_recovery_accepted",
            "backlog_detected",
            "backlog_rescue_accepted",
            "readiness_snapshot_computed"
        ],
        "operational_metrics": [
            "plan_generation_latency",
            "today_endpoint_latency",
            "mock_analysis_job_time",
            "revision_queue_size",
            "backlog_detection_count",
            "readiness_compute_failures",
            "premium_check_failures"
        ],
        "logs": [
            "structured request logs",
            "job execution logs",
            "domain mutation audit logs"
        ]
    },
    "data_integrity_rules": [
        "Only one active mission plan per user.",
        "Only one open focus session per user at a time.",
        "Task status transitions must be validated.",
        "Revision completion must advance interval stage or reschedule according to policy.",
        "Mock recovery acceptance must be idempotent.",
        "Backlog rescue acceptance must not duplicate rebuild tasks."
    ],
    "idempotency_and_concurrency": {
        "required_for": [
