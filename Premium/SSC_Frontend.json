{
    "product_name": "SSC Mission Mode",
    "version": "1.0.0",
    "owner": "Productivity Platform for SSC Aspirants",
    "objective": "Create a premium adaptive study execution experience that tells SSC aspirants what to study today, what to revise, how to recover after bad mocks, and whether they are still on track.",
    "positioning": {
        "category": "premium execution engine",
        "not_positioned_as": [
            "course library",
            "mock test platform clone",
            "generic to-do app",
            "generic timer app"
        ],
        "core_value": [
            "daily clarity",
            "revision discipline",
            "mock recovery",
            "backlog rescue",
            "preparation confidence"
        ]
    },
    "target_user": {
        "primary": "SSC aspirant preparing for CGL, CHSL, MTS, GD, or Steno",
        "secondary": "student already using external mocks but lacking structure and consistency",
        "mindset": [
            "feels overwhelmed by syllabus",
            "does not know what to study next",
            "forgets studied topics",
            "misses days and loses momentum",
            "needs visible progress and realistic planning"
        ]
    },
    "premium_gating": {
        "free_features": [
            "manual task creation",
            "basic focus timer",
            "simple streaks",
            "basic task completion history",
            "manual study logging"
        ],
        "premium_features": [
            "mission onboarding and adaptive plan generation",
            "automatic daily study plan",
            "smart revision queue",
            "mock recovery recommendations",
            "backlog rescue flow",
            "readiness meter",
            "weekly mission review",
            "topic-risk insights",
            "adaptive rebalancing after skipped days"
        ],
        "upgrade_triggers": [
            "user tries to generate first mission plan",
            "user tries to unlock revision queue",
            "user enters mock data and tries to view recovery plan",
            "user misses days and tries to run backlog rescue",
            "user opens readiness dashboard"
        ]
    },
    "product_principles": [
        "Today must be the home screen, not a deep analytics wall.",
        "The app must tell the student what to do next instead of showing too many options.",
        "Every insight must end in an action.",
        "Missed days must trigger recovery, not guilt.",
        "Metrics must be simple enough for non-technical users.",
        "UI must reduce anxiety and decision fatigue.",
        "Premium must feel like better direction, not locked basic utility."
    ],
    "success_metrics": {
        "north_star": "weekly mission adherence rate",
        "primary_metrics": [
            "daily plan completion rate",
            "revision due completion rate",
            "weekly active premium users",
            "mock recovery plan adoption rate",
            "backlog rescue usage rate",
            "day-7 retention",
            "day-30 retention",
            "premium conversion after plan generation",
            "average study sessions per user per week"
        ],
        "secondary_metrics": [
            "average task skip rate",
            "subject balance compliance",
            "focus session completion rate",
            "mock entry frequency",
            "time-to-first-completed-plan",
            "time-to-first-revision-completion"
        ]
    },
    "navigation": {
        "top_level_tabs": [
            "Today",
            "Mission Plan",
            "Revision",
            "Mocks",
            "Progress"
        ],
        "secondary_destinations": [
            "Mission Onboarding",
            "Backlog Rescue",
            "Weekly Review",
            "Mission Settings",
            "Premium Upgrade"
        ],
        "routing": [
            {
                "route": "/mission/onboarding",
                "access": "premium"
            },
            {
                "route": "/mission/today",
                "access": "premium"
            },
            {
                "route": "/mission/plan",
                "access": "premium"
            },
            {
                "route": "/mission/revision",
                "access": "premium"
            },
            {
                "route": "/mission/mocks",
                "access": "premium"
            },
            {
                "route": "/mission/progress",
                "access": "premium"
            },
            {
                "route": "/mission/backlog-rescue",
                "access": "premium"
            },
            {
                "route": "/mission/weekly-review",
                "access": "premium"
            },
            {
                "route": "/premium/mission-mode",
                "access": "all_authenticated_users"
            }
        ]
    },
    "global_ui_rules": {
        "tone": "clear, strict, encouraging, non-preachy",
        "visual_style": [
            "clean, minimal, calm",
            "high information clarity",
            "strong card hierarchy",
            "limited color meanings",
            "red only for actual risk",
            "no noisy gamification"
        ],
        "copy_rules": [
            "Avoid vague motivational text.",
            "Use specific study language.",
            "Show exact recommended actions.",
            "Prefer short phrases over paragraphs.",
            "Use verbs like Study, Revise, Recover, Continue, Rebuild."
        ],
        "status_colors": {
            "done": "green",
            "in_progress": "blue",
            "due_today": "amber",
            "overdue": "red",
            "upcoming": "neutral",
            "premium_locked": "muted"
        }
    },
    "core_state_model": {
        "mission_plan_status": [
            "not_created",
            "draft",
            "active",
            "needs_rebalance",
            "backlog_detected",
            "completed",
            "archived"
        ],
        "task_status": [
            "not_started",
            "in_progress",
            "done",
            "partial",
            "skipped",
            "rescheduled"
        ],
        "revision_status": [
            "due",
            "completed",
            "overdue",
            "snoozed"
        ],
        "mock_status": [
            "not_entered",
            "entered",
            "analyzed",
            "recovery_generated"
        ],
        "readiness_band": [
            "critical",
            "weak",
            "stable",
            "strong"
        ]
    },
    "primary_entities_for_ui": [
        {
            "name": "MissionPlan",
            "fields": [
                "id",
                "exam_type",
                "target_exam_date",
                "daily_hours_weekday",
                "daily_hours_weekend",
                "subjects",
                "created_at",
                "status",
                "readiness_score",
                "coverage_score",
                "consistency_score",
                "revision_health_score",
                "mock_health_score"
            ]
        },
        {
            "name": "MissionTask",
            "fields": [
                "id",
                "date",
                "subject",
                "topic",
                "task_type",
                "estimated_minutes",
                "priority",
                "status",
                "source",
                "linked_revision_id",
                "linked_mock_id",
                "completion_confidence",
                "session_count"
            ]
        },
        {
            "name": "RevisionItem",
            "fields": [
                "id",
                "subject",
                "topic",
                "due_date",
                "interval_stage",
                "risk_level",
                "reason",
                "status"
            ]
        },
        {
            "name": "MockAnalysis",
            "fields": [
                "id",
                "mock_name",
                "date_taken",
                "overall_score",
                "section_scores",
                "accuracy_by_topic",
                "time_spent_by_section",
                "weak_topics",
                "careless_error_topics",
                "recovery_plan_summary"
            ]
        },
        {
            "name": "FocusSession",
            "fields": [
                "id",
                "task_id",
                "planned_minutes",
                "actual_minutes",
                "break_count",
                "completed",
                "end_reason",
                "notes",
                "confidence_after_session"
            ]
        }
    ],
    "screens": [
        {
            "screen_id": "mission_onboarding",
            "route": "/mission/onboarding",
            "purpose": "Collect enough context to generate the first adaptive study mission.",
            "entry_conditions": [
                "premium user with no mission plan",
                "free user from upgrade flow"
            ],
            "sections": [
                {
                    "name": "exam_selection",
                    "components": [
                        "exam_type_cards",
                        "attempt_target_picker",
                        "exam_date_picker"
                    ]
                },
                {
                    "name": "availability",
                    "components": [
                        "weekday_hours_input",
                        "weekend_hours_input",
                        "preferred_study_slots",
                        "off_day_selector"
                    ]
                },
                {
                    "name": "self_assessment",
                    "components": [
                        "subject_confidence_sliders",
                        "current_preparation_stage_selector",
                        "language_preference_toggle",
                        "mock_usage_toggle"
                    ]
                },
                {
                    "name": "mission_summary",
                    "components": [
                        "plan_preview_card",
                        "premium_value_reminder",
                        "generate_plan_cta"
                    ]
                }
            ],
            "validation_rules": [
                "exam type required",
                "target exam date required",
                "at least one available study slot required",
                "at least one subject confidence input required"
            ],
            "empty_states": [],
            "error_states": [
                "plan_generation_failed",
                "network_error",
                "premium_required"
            ],
            "cta": "Generate My Mission"
        },
        {
            "screen_id": "today_home",
            "route": "/mission/today",
            "purpose": "This is the operational home. It must answer what to do today without forcing the user to think.",
            "layout_priority": [
                "today_main_tasks",
                "revision_due_today",
                "urgent_recovery_items",
                "readiness_snapshot",
                "continue_session"
            ],
            "components": [
                {
                    "name": "today_header",
                    "props": [
                        "greeting",
                        "today_date",
                        "exam_countdown_days",
                        "mission_status"
                    ]
                },
                {
                    "name": "readiness_snapshot_card",
                    "props": [
                        "readiness_score",
                        "band",
                        "one_line_reason",
                        "view_full_progress_action"
                    ]
                },
                {
                    "name": "today_mission_card_stack",
                    "props": [
                        "top_3_tasks",
                        "estimated_total_minutes",
                        "priority_labels",
                        "start_first_task_cta"
                    ]
                },
                {
                    "name": "revision_due_card",
                    "props": [
                        "due_count",
                        "most_risky_topics",
                        "start_revision_cta"
                    ]
                },
                {
                    "name": "mock_recovery_card",
                    "props": [
                        "active_recovery_plan",
                        "topics_to_repair",
                        "repair_session_cta"
                    ]
                },
                {
                    "name": "backlog_alert_banner",
                    "props": [
                        "missed_days_count",
                        "rebuild_plan_cta"
                    ]
                },
                {
                    "name": "continue_session_card",
                    "props": [
                        "active_task",
                        "elapsed_time",
                        "resume_cta"
                    ]
                }
            ],
            "empty_states": [
                "no_tasks_today_show_rebalance_or_rest_day_message",
                "no_revision_due_show_next_revision_date",
                "no_mock_data_show_enter_mock_prompt"
            ],
            "success_conditions": [
                "user can start a task in one tap",
                "user understands priority within 5 seconds",
                "user sees if they are behind"
            ]
        },
        {
            "screen_id": "mission_plan",
            "route": "/mission/plan",
            "purpose": "Show the full adaptive study plan with weekly and daily breakdowns.",
            "views": [
                "week_view",
                "day_view",
                "subject_view"
            ],
            "components": [
                "weekly_timeline",
                "daily_task_list",
                "subject_distribution_chart",
                "task_detail_drawer",
                "reschedule_task_action",
                "mark_partial_action",
                "mark_done_action"
            ],
            "interaction_rules": [
                "student may reschedule low-priority tasks only within policy",
                "adaptive tasks show source badges like generated_from_weakness or generated_from_revision",
                "completed tasks are visually compact, not dominant"
            ],
            "empty_states": [
                "no_plan_generated"
            ]
        },
        {
            "screen_id": "focus_session_player",
            "route": "/mission/today/task/:taskId/session",
            "purpose": "Run the actual study session tied to a mission task.",
            "components": [
                {
                    "name": "task_context_header",
                    "props": [
                        "subject",
                        "topic",
                        "task_type",
                        "target_minutes"
                    ]
                },
                {
                    "name": "focus_timer",
                    "props": [
                        "countdown",
                        "pause",
                        "resume",
                        "stop",
                        "extend_by_5",
                        "break_mode"
                    ]
                },
                {
                    "name": "session_goal_card",
                    "props": [
                        "goal_text",
                        "expected_outcome",
                        "linked_topic_reason"
                    ]
                },
                {
                    "name": "quick_notes_panel",
                    "props": [
                        "text_area",
                        "save_draft"
                    ]
                },
                {
                    "name": "session_completion_sheet",
                    "props": [
                        "done_partial_skipped_selector",
                        "confidence_rating_1_to_5",
                        "why_stopped_reason",
                        "next_step_suggestion"
                    ]
                }
            ],
            "rules": [
                "if user stops before minimum threshold, mark as partial unless explicitly skipped",
                "session completion must update related task and readiness signals",
                "timer may continue in background if app state supports it"
            ]
        },
        {
            "screen_id": "revision_queue",
            "route": "/mission/revision",
            "purpose": "Show due revisions in the simplest order possible.",
            "layout_priority": [
                "due_today",
                "overdue",
                "upcoming"
            ],
            "components": [
                "revision_summary_header",
                "due_today_list",
                "overdue_list",
                "revision_topic_chip_filters",
                "complete_revision_action",
                "snooze_revision_action",
                "risk_reason_badges"
            ],
            "rules": [
                "overdue items must be visually separated from today items",
                "each revision card must explain why it is due",
                "snooze is allowed but should feel costly and limited"
            ],
            "card_fields": [
                "subject",
                "topic",
                "last_studied",
                "due_reason",
                "estimated_minutes",
                "risk_level"
            ]
        },
        {
            "screen_id": "mock_center",
            "route": "/mission/mocks",
            "purpose": "Collect mock results and turn them into an action plan.",
            "sections": [
                {
                    "name": "mock_entry",
                    "components": [
                        "mock_name_input",
                        "date_taken_picker",
                        "overall_score_input",
                        "section_score_inputs",
                        "accuracy_inputs",
                        "time_spent_inputs",
                        "topic_error_entry"
                    ]
                },
                {
                    "name": "mock_analysis_summary",
                    "components": [
                        "score_change_widget",
                        "speed_vs_accuracy_widget",
                        "weak_topics_list",
                        "careless_error_topics_list",
                        "high_priority_repair_topics"
                    ]
                },
                {
                    "name": "recovery_plan",
                    "components": [
                        "next_3_day_plan",
                        "repair_sessions",
                        "plan_adjustment_preview",
                        "add_to_today_cta"
                    ]
                }
            ],
            "rules": [
                "analysis must not stay as raw numbers only",
                "every weak topic must generate a suggested recovery action",
                "if user has not entered enough mock data, show guidance instead of empty charts"
            ]
        },
        {
            "screen_id": "progress_dashboard",
            "route": "/mission/progress",
            "purpose": "Give confidence and strategic clarity, not vanity analytics.",
            "sections": [
                {
                    "name": "readiness_overview",
                    "components": [
                        "readiness_score_ring",
                        "band_label",
                        "top_risk_reason",
                        "top_strength_reason"
                    ]
                },
                {
                    "name": "health_breakdown",
                    "components": [
                        "coverage_score_card",
                        "consistency_score_card",
                        "revision_health_card",
                        "mock_health_card"
                    ]
                },
                {
                    "name": "trend_section",
                    "components": [
                        "weekly_completion_trend",
                        "study_time_trend",
                        "revision_trend",
                        "mock_trend"
                    ]
                },
                {
                    "name": "risk_section",
                    "components": [
                        "at_risk_subjects",
                        "ignored_topics",
                        "revision_debt_card",
                        "backlog_risk_card"
                    ]
                },
                {
                    "name": "recommended_actions",
                    "components": [
                        "top_3_recommended_actions",
                        "run_backlog_rescue_cta",
                        "start_revision_cta",
                        "repair_weak_topics_cta"
                    ]
                }
            ],
            "rules": [
                "dashboard must interpret metrics in plain language",
                "no chart should exist without a linked action",
                "avoid too many percentages on first fold"
            ]
        },
        {
            "screen_id": "backlog_rescue",
            "route": "/mission/backlog-rescue",
            "purpose": "Help the student restart after missed days without emotional overload.",
            "trigger_conditions": [
                "two or more missed study days",
                "multiple overdue revisions",
                "falling readiness due to inactivity"
            ],
            "components": [
                "backlog_summary",
                "what_will_change_preview",
                "preserve_high_priority_toggle",
                "drop_low_priority_toggle",
                "compressed_rebuild_preview",
                "accept_new_plan_cta"
            ],
            "ux_rules": [
                "must feel forgiving, not scolding",
                "must explain what is preserved vs compressed",
                "must show realistic next steps immediately"
            ]
        },
        {
            "screen_id": "weekly_review",
            "route": "/mission/weekly-review",
            "purpose": "Summarize the week and reset the next one.",
            "components": [
                "weekly_completion_summary",
                "best_subject_improvement_card",
                "most_ignored_subject_card",
                "revision_debt_summary",
                "mock_impact_summary",
                "next_week_focus_areas",
                "confirm_next_week_plan_cta"
            ],
            "rules": [
                "weekly review should be fast and actionable",
                "must end by confirming the next week's priorities"
            ]
        },
        {
            "screen_id": "premium_paywall",
            "route": "/premium/mission-mode",
            "purpose": "Convert users by showing the outcome, not feature jargon.",
            "components": [
                "hero_value_block",
                "before_after_state_comparison",
                "feature_value_cards",
                "mock_recovery_demo",
                "readiness_demo",
                "pricing_cards",
                "unlock_cta"
            ],
            "copy_focus": [
                "stop guessing what to study",
                "automatic revision reminders",
                "recover after bad mocks",
                "rebuild after missed days",
                "know if you are on track"
            ]
        }
    ],
    "shared_components": [
        {
            "name": "MissionTaskCard",
            "variants": [
                "today_priority",
                "normal",
                "recovery_task",
                "revision_task"
            ],
            "fields": [
                "subject",
                "topic",
                "estimated_minutes",
                "priority",
                "status",
                "task_source"
            ],
            "actions": [
                "start",
                "mark_done",
                "mark_partial",
                "skip",
                "reschedule"
            ]
        },
        {
            "name": "ReadinessScoreWidget",
            "fields": [
                "score",
                "band",
                "reason",
                "delta_from_last_week"
            ]
        },
        {
            "name": "RevisionCard",
            "fields": [
                "topic",
                "subject",
                "due_reason",
                "risk_level",
                "estimated_minutes"
            ],
            "actions": [
                "start_revision",
                "complete",
                "snooze"
            ]
        },
        {
            "name": "MockRecoveryCard",
            "fields": [
                "topic",
                "problem_type",
                "repair_action",
                "suggested_minutes"
            ]
        },
        {
            "name": "BacklogAlert",
            "fields": [
                "missed_days",
                "overdue_items",
                "impact_summary"
            ],
            "actions": [
                "open_rescue"
            ]
        }
    ],
    "frontend_business_logic": {
        "plan_generation_flow": [
            "collect onboarding inputs",
            "submit generate_plan request",
            "show skeleton state",
            "receive plan summary and first 7-day tasks",
            "redirect to today_home",
            "show first-run tutorial hints"
        ],
        "task_completion_flow": [
            "start task",
            "enter focus session",
            "submit session end state",
            "update task state locally",
            "sync server",
            "refresh readiness snapshot and today's queue"
        ],
        "revision_flow": [
            "fetch due revisions",
            "student completes revision",
            "send completion confidence",
            "receive next interval update",
            "refresh due list"
        ],
        "mock_recovery_flow": [
            "submit mock data",
            "fetch analysis",
            "render weak areas and action plan",
            "allow one-tap add repair tasks to today or plan"
        ],
        "backlog_rescue_flow": [
            "detect missed days",
            "show non-blocking banner",
            "open rescue preview",
            "user accepts rebuild",
            "replace future low-priority schedule with rebuilt plan"
        ]
    },
    "client_data_fetching": {
        "critical_queries": [
            "get_active_mission_plan",
            "get_today_tasks",
            "get_due_revisions",
            "get_active_focus_session",
            "get_latest_readiness_snapshot",
            "get_mock_recovery_summary",
            "get_backlog_status"
        ],
        "mutations": [
            "generate_mission_plan",
            "update_mission_settings",
            "complete_task",
            "complete_focus_session",
            "skip_task",
            "reschedule_task",
            "complete_revision",
            "snooze_revision",
            "submit_mock",
            "accept_recovery_plan",
            "run_backlog_rescue"
        ],
        "cache_policy": {
            "today_home": "stale_while_revalidate",
            "focus_session": "network_priority_with_local_fallback",
            "progress_dashboard": "cache_1_minute",
            "weekly_review": "cache_5_minutes"
        }
    },
    "analytics_events": [
        "mission_onboarding_started",
        "mission_plan_generated",
        "today_first_task_started",
        "task_completed",
        "task_skipped",
        "revision_completed",
        "revision_snoozed",
        "mock_submitted",
        "mock_recovery_viewed",
        "mock_recovery_accepted",
        "backlog_rescue_opened",
        "backlog_rescue_accepted",
        "paywall_viewed",
        "premium_unlocked"
    ],
    "notifications_and_nudges": {
        "in_app": [
            "today_plan_ready",
            "revision_due_today",
            "backlog_detected",
            "readiness_drop_alert",
            "weekly_review_ready"
        ],
        "push_optional": [
            "start your first task",
            "you have 2 revisions due",
            "your plan has slipped, rescue it now",
            "weekly mission review is ready"
        ],
        "notification_rules": [
            "do not spam more than 2 high-priority nudges a day",
            "no motivational fluff without action",
            "every nudge must deep link into a specific screen"
        ]
    },
    "empty_state_policy": {
        "goal": "Every empty state must explain what the user should do next.",
        "examples": [
            {
                "case": "no_mission_plan",
                "message": "Create your Mission to get a daily study path."
            },
            {
                "case": "no_revision_due",
                "message": "No revision due today. Stay on your main mission."
            },
            {
                "case": "no_mock_data",
                "message": "Add one mock to unlock recovery insights."
            }
        ]
    },
    "error_handling": {
        "user_facing_principles": [
            "errors must be short and specific",
            "show retry when safe",
            "never lose session notes on error",
            "allow graceful offline fallback for session logging"
        ],
        "known_errors": [
            "plan_generation_failed",
            "session_sync_failed",
            "mock_analysis_unavailable",
            "backlog_rescue_failed",
            "premium_verification_failed"
        ]
    },
    "accessibility": {
        "requirements": [
            "high contrast text",
            "large tap targets",
            "clear color + text labels for status",
            "screen-reader friendly timer states",
            "subject and risk badges must not rely on color alone"
        ]
    },
    "performance_constraints": {
        "today_home_load_goal_ms": 2000,
        "focus_session_interaction_goal_ms": 100,
        "dashboard_chart_count_above_fold_max": 2,
        "avoid_heavy_animation": true
    },
    "mvp_scope": {
        "must_have": [
            "mission onboarding",
            "today home",
            "mission plan view",
            "focus session player",
            "revision queue",
            "mock entry and recovery summary",
            "progress dashboard",
