# Session secret - generate a random string for production
SESSION_SECRET=your-super-secret-key-change-in-production

# Railway will auto-set this, but you can override
PORT=8080

# PostgreSQL Database (Neon)
# Get your connection string from: https://console.neon.tech
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# DB pool size (use with Neon pooled connection string)
# DB_POOL_MAX=25

# Redis (for production session store)
# Example: redis://default:password@host:port/0
REDIS_URL=redis://default:password@host:6379/0
# Optional session key prefix
# REDIS_SESSION_PREFIX=nistha:sess:
# Optional strict mode: crash startup if Redis is unavailable
# REDIS_REQUIRED=true

# Public base URL used in reset links (e.g. https://app.example.com)
APP_BASE_URL=http://localhost:8080

# Vultr Object Storage (Vultr-hosted, S3-compatible API)
# Make the bucket public if you want uploads to be directly accessible by URL.
# Optional: set VULTR_PUBLIC_BASE_URL if you serve the bucket through a custom domain or CDN.
# VULTR_ACCESS_KEY=your_access_key
# VULTR_SECRET_KEY=your_secret_key
# VULTR_ENDPOINT=https://ewr1.vultrobjects.com
# VULTR_BUCKET_NAME=safar-uploads
# VULTR_BUCKET_REGION=ewr
# VULTR_PUBLIC_BASE_URL=https://ewr1.vultrobjects.com/safar-uploads

# MongoDB (required by current server routes)
# Example: mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
# MONGODB_URI=
# MONGODB_DB_NAME=safar

# Mehfil moderation controls
# You can keep these in .env_open (commit-safe) instead of .env.
# Set true only when you explicitly want to disable Mehfil access
# MEHFIL_PAUSED=false
# Groq API for AI moderation (recommended)
# GROQ_API_KEY=
# Optional Wishbox-specific Groq key. If set, Wishbox uses this before GROQ_API_KEY.
# The mixed-case name is supported for compatibility with local .env files.
# Wishbox always uses llama-3.1-8b-instant.
# Wishbox_GROQ_API_KEY=
# WISHBOX_GROQ_API_KEY=
# Optional model override
# MEHFIL_GROQ_MODEL=llama-3.1-8b-instant
# Optional TTL hours for flagged BULLSHIT posts
# MEHFIL_BULLSHIT_TTL_HOURS=24
# Comma-separated emails exempt from moderation QA paths
# MEHFIL_MODERATION_BYPASS_EMAILS=qa@example.com

# Optional override specifically for password reset links
# PASSWORD_RESET_BASE_URL=https://app.example.com

# Gmail SMTP for password reset emails (no custom domain required)
# REQUIRED in production for forgot-password to work.
# Use a Gmail account + 16-digit App Password (Google Account > Security > App passwords)
# GMAIL_USER=yourgmail@gmail.com
# GMAIL_APP_PASSWORD=your_16_digit_app_password
# Optional sender display/email. Defaults to SAFAR Support <GMAIL_USER>
# GMAIL_FROM_EMAIL=SAFAR Support <yourgmail@gmail.com>
# Optional SMTP override (defaults below)
# GMAIL_SMTP_HOST=smtp.gmail.com
# GMAIL_SMTP_PORT=465

# Legacy Turso variables (no longer used after PostgreSQL migration)
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=

# Razorpay Payment Gateway
# Get your keys from: https://dashboard.razorpay.com â†’ Settings â†’ API Keys
# Use test keys (rzp_test_xxx) for development, live keys (rzp_live_xxx) for production
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET
# Optional: Webhook secret for payment notifications
# RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET

# â”€â”€ Mobile / Android App Auth (JWT) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Generate two long random strings (e.g.: openssl rand -hex 64)
# JWT_ACCESS_SECRET=your-access-secret
# JWT_REFRESH_SECRET=your-refresh-secret
# Optional legacy fallback used when the two values above are not set:
# JWT_SECRET=single-shared-jwt-secret
# Optional TTL overrides (default: 15m access, 30d refresh)
# JWT_ACCESS_TTL=15m
# JWT_REFRESH_TTL=30d

# â”€â”€ Mobile / Android Push Notifications (FCM) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# From Firebase Console â†’ Project Settings â†’ Service Accounts â†’ Generate new private key
# Paste the ENTIRE downloaded JSON as a single-line string value here.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# ── Web Push Notifications (FCM Web) ─────────────────────────────────────────
# From Firebase Console → Project Settings → General → Your apps → Web app
# These are public client-side identifiers used by the website frontend.
# VITE_FIREBASE_API_KEY=AIzaSy...
# VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your-project-id
# VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
# VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
# VITE_FIREBASE_APP_ID=1:123456789:web:abc123
# From Firebase Console → Project Settings → Cloud Messaging → Web Push certificates → Key pair
# VITE_FIREBASE_VAPID_KEY=BL...

# â”€â”€ Admin â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Comma-separated admin emails (used for Sandesh, Mehfil moderation, test-push)
# ADMIN_EMAILS=admin@gmail.com,owner@gmail.com
